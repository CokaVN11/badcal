{
	"name": "personal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "partytown copylib static/~partytown || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:migration:create": "ts-node --project tsconfig.json -r reflect-metadata import { DataSource } from 'typeorm'; new DataSource({ type: 'postgres', url: process.env.DATABASE_URL, entities: ['src/lib/server/db/entities/*.ts'], migrations: ['src/lib/server/db/migrations/*.ts'] }).runMigration(); console.log('Hand-author your migration file in src/lib/server/db/migrations/ then run db:migration:run')",
		"db:migration:run": "node --import reflect-metadata ts-node/esm --project tsconfig.json src/lib/server/db/typeorm-cli-data-source.ts migration:run",
		"db:migration:revert": "node --import reflect-metadata ts-node/esm --project tsconfig.json src/lib/server/db/typeorm-cli-data-source.ts migration:revert"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@inlang/paraglide-js": "^2.5.0",
		"@qwik.dev/partytown": "^0.11.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22",
		"@types/qrcode": "^1.5.6",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.2",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.560.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.1",
		"@tabler/icons-svelte-runes": "^3.36.0",
		"@tanstack/svelte-form": "^1.27.2",
		"@tanstack/zod-form-adapter": "^0.42.1",
		"@vercel/analytics": "^1.6.1",
		"bits-ui": "^2.14.4",
		"dayjs": "^1.11.20",
		"html-to-image": "^1.11.13",
		"openai": "^6.10.0",
		"pg": "^8.20.0",
		"qrcode": "^1.5.4",
		"reflect-metadata": "^0.2.2",
		"svelte-sonner": "^1.0.7",
		"typeorm": "^0.3.28",
		"vietnam-qr-pay": "^1.5.0",
		"zod": "^4.1.13"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentHash  String       @unique @map("content_hash")
  sessionTitle String       @map("session_title")
  sessionDate  String       @map("session_date")
  createdAt    DateTime     @default(now()) @map("created_at")
  courtBlocks  CourtBlock[]
  extraCosts   ExtraCost[]
  groups       Group[]
  paidStatuses PaidStatus[]

  @@index([contentHash], name: "idx_sessions_content_hash")
  @@map("sessions")
}

model CourtBlock {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String  @map("session_id") @db.Uuid
  courtCount   Int     @map("court_count")
  startTime    String  @map("start_time")
  endTime      String  @map("end_time")
  pricePerHour Int     @map("price_per_hour")
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], name: "idx_court_blocks_session")
  @@map("court_blocks")
}

model ExtraCost {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String  @map("session_id") @db.Uuid
  label     String  @map("label")
  amount    Int     @map("amount")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], name: "idx_extra_costs_session")
  @@map("extra_costs")
}

model Group {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  playerNames String[] @map("player_names")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], name: "idx_groups_session")
  @@map("groups")
}

model SavedLineup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @map("name")
  playerNames String[] @map("player_names")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("saved_lineups")
}

model PaidStatus {
  sessionId String   @map("session_id") @db.Uuid
  playerId  Int      @map("player_id")
  paidAt    DateTime @default(now()) @map("paid_at")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, playerId])
  @@index([sessionId], name: "idx_paid_status_session")
  @@map("paid_status")
}

{
	"buildCommand": "pnpm build",
	"outputDirectory": "dist",
	"devCommand": "pnpm dev",
	"installCommand": "pnpm install",
	"framework": null,
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	],
	"headers": [
		{
			"source": "/~partytown/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=365000000, immutable"
				}
			]
		},
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				}
			]
		}
	]
}
